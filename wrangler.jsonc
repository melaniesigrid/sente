{
  // Joseki game server: one Worker, three Durable Object classes.
  //   Registry  a single instance ("main"): accounts, tokens, matchmaking, the ladder
  //   Room      one instance per game: the GameRecord, seats, chat, sockets
  //   Club      one instance per club: the hall, its channels, who is standing in it
  // Deploy with `npm run deploy:server`; develop with `npm run dev:server` (port 8787).
  "$schema": "node_modules/wrangler/config-schema.json",
  // The script name stays `sente-server` for the same reason the storage keys
  // do: the Durable Object namespaces hang off it, and a rename would strand
  // every account and every game on namespaces nothing points at.
  "name": "sente-server",
  "main": "server/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // The server answers on its own subdomain, so the app and the API are one
  // registrable domain and the client never names a Cloudflare address.
  // `custom_domain` makes wrangler create the DNS record and the certificate
  // on deploy; the zone has to be on this Cloudflare account first, or the
  // deploy fails rather than half-succeeding. workers.dev keeps answering too.
  "routes": [{ "pattern": "api.joseki.online", "custom_domain": true }],

  // Cloudflare Email Sending, for the two letters in server/mail.js. The
  // binding is unrestricted because the recipient is whichever address the
  // person signed up with; the sender is not, and that is the part that needs
  // setting up: MAIL_FROM has to be an address on a domain onboarded with
  // `npx wrangler email sending enable <domain>`, and until it is set the
  // server reports `"mail": "off"` at /api/health and writes links to the log
  // instead of posting them. See docs/server-operations.md.
  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    // Where the links in those letters point: the app, not this Worker.
    "APP_URL": "https://joseki.online/",
    "MAIL_FROM_NAME": "Joseki",
    // An address on the onboarded domain. It is not a mailbox anyone reads;
    // Email Routing forwards anything sent back to it.
    "MAIL_FROM": "hello@joseki.online"
  },
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "ROOM", "class_name": "Room" },
      { "name": "CLUB", "class_name": "Club" }
    ]
  },
  /* A new tag rather than an edit to v1: migrations are a log, and a class
     that was never in v1 has to arrive in a tag of its own, or a Worker that
     has already been deployed has nothing left to apply. */
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Registry", "Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Club"] }
  ]
}
